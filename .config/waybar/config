{   // Estilo Trasnparente

    // General
    "layer": "top",
    "position": "top",
    "height": 14,    // Waybar height (to be removed for auto height)
    //"width": 1728,
    "spacing": 2,    // Gaps between modules (4px)
    "margin-top": 0, // Gap to top of screen
    "margin-bottom": 0,

    // Elegir el orden de los modulos
    "modules-left": ["tray","cpu","temperature","memory","custom/updates"],
    "modules-center": ["hyprland/workspaces"],
    "modules-right": ["custom/special","pulseaudio", "clock","custom/power"],

    // configuracion de los Modules 
    "tray": {
        "icon-size": 19,
        "spacing": 10
    },
    "custom/special": {
        "exec": "~/.config/waybar/scripts/workspace-especial",
        "interval": 5,
        "tooltip": false
    },
    "custom/power":{
        "format":"<span color='#222330'> ⏻ </span>",
        "on-click": "~/.config/rofi/power/powm.sh"
    },
    "custom/updates":{
        "format": "{} {icon}",
        "tooltip": true,
        "tooltip-format": "<span color='#ffae42'> </span> actualizaciones Pendientes de sistema",
        "on-click": "~/.config/waybar/scripts/upda_term.sh",
       	"format-icons": {
			"default": [
                "<span color='#ffae42'> </span>", 
            ]
            },

 "exec": "checkupdates | wc -l",
        "exec-if": "[[ $(checkupdates | wc -l) != 0 ]]",
        "interval": 5,
    },
	"clock": {
        "timezone": "America/Argentina/Buenos_Aires",
        "tooltip": true,
        "interval": 1,
        "format": "{:%H:%M %p}",
        "tooltip-format": "{:L%a-%d-%m-%Y}",
        "locale": "es_AR.UTF-8",
    },
    "cpu": {
        "format": "{usage}% ",
        "tooltip": false
    },
    "memory": {
        "format": "{}% <span color='#9ece6a'> </span>"
    },
    "temperature": {
        // "thermal-zone": 2,
        // "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
        "critical-threshold": 80,
        // "format-critical": "{temperatureC}°C {icon}",
        "format": "{temperatureC}°C {icon}",
        "format-icons": ["", "", ""]
    },
    "backlight": {
        // "device": "acpi_video1",
        "format": "{percent}% {icon}",
        "format-icons": ["", "", "", "", "", "", "", "", ""]
    },
    "hyprland/workspaces": {
		"disable-scroll": true,
        "on-click": "activate",
        "all-outputs": true,
        "active-only": false,
        /*"persistent-workspaces": {
            "1": [],
            "2": [],
            "3": [],
            "4": [],
            "5": [],
            "6": [],
        },*/
        "format": "<span font='12'color='#ffac33'>{icon}</span>", // Color icono cuando no tiene
        "format-icons": {
            "active": "<span font='12'color='#fafc33'>󰮯</span>",
            "empty": "<span font='12'color='#fa123d'>󰊠</span>",
            //"default": "<span font='12'color='#7dcfff'>󰊠</span>",
            "persistent": "󰊠",
        },
    },
   "pulseaudio": {
    	"tooltip": false,
    	"scroll-step": 5,
    	"format": "{icon} {volume}%",
    	"format-muted": "<span color='#fa123d'> </span> {volume}%",
    	"on-click":"pactl set-sink-mute @DEFAULT_SINK@ toggle",
         "format-icons": {
             "headphone": "<span color='#86fd2d'> </span>",
    	     "headphone-icon-size": 51,
             "hands-free": "<span color='#FF5733'> </span>",
             "headset": "",
             "phone": "",
             "portable": "",
             "car": "",
             "default": ["<span color='#7aa2f7'> </span>", "<span color='#7aa2f7'> </span>", "<span color='#7aa2f7'> </span>"]
                      },
	},
    "battery": {
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 10
        },
        "format": "{icon}  <span color='#F1F1F1'>{capacity}%</span>",
        "format-charging": "<span color='#9ece6a'></span> <span color='#F1F1F1'>{capacity}%</span>",
        "format-plugged": " <span color='#F1F1F1'>{capacity}</span>%",
        "format-alt": "<span color='#F1F1F1'>{time}</span> {icon}",
        "format-icons": [
            "<span color='#f7768e'></span>", 
            "<span color='#e0af68'></span>", 
            "<span color='#e0af68'></span>", 
            "<span color='#9ece6a'></span>", 
            "<span color='#9ece6a'></span>"
        ]
    },
}
